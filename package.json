  "module": "es2022",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bunx @biomejs/biome lint ./src",
    "fmt": "bunx @biomejs/biome format --write ./src *.js *.ts *.json",
    "fix": "bunx @biomejs/biome check --apply ./src *.js *.ts *.json",
    "unsafe": "bunx @biomejs/biome check --apply-unsafe ./src *js *.ts *.json"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.0.0-rc-fb9a90fa48-20240614",
    "react-dom": "19.0.0-rc-fb9a90fa48-20240614"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.20.5",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0",
    "autoprefixer": "10.6.1",
    "dotenv": "18.0.8",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0"
  }
