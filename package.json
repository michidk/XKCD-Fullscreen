{
  "name": "xkcd-fullscreen",
  "description": "A simple XKCD fullscreen viewer built for digitale signage.",
  "version": "0.1.0",
  "license": "MIT",
  "module": "es2022",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bunx @biomejs/biome lint ./src",
    "fmt": "bunx @biomejs/biome format --write ./src *.js *.ts *.json",
    "fix": "bunx @biomejs/biome check --apply ./src *.js *.ts *.json",
    "unsafe": "bunx @biomejs/biome check --apply-unsafe ./src *js *.ts *.json"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0",
    "autoprefixer": "10.6.1",
    "dotenv": "^18.0.0",
    "postcss": "8.5.31",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0"
  }
}
